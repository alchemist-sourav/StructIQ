# ==============================================================================
# STAGE 1: Base - Defines the core image and dependencies
# ==============================================================================
# Using Node 22 Alpine as requested for a lightweight and secure base
FROM node:22-alpine AS base

# Install libc6-compat for Alpine. Required for some Node modules (like Prisma, SWC, etc.)
RUN apk add --no-cache libc6-compat

# Set the working directory inside the container
WORKDIR /app

# ==============================================================================
# STAGE 2: Dependencies - Install node modules
# ==============================================================================
FROM base AS deps

# Copy only the package files first to leverage Docker layer caching
COPY package.json package-lock.json* ./

# Install dependencies strictly using the lockfile
RUN npm ci

# ==============================================================================
# STAGE 3: Build - Compile the Next.js application
# ==============================================================================
FROM base AS builder

WORKDIR /app

# Copy dependencies from the 'deps' stage
COPY --from=deps /app/node_modules ./node_modules
# Copy all source files (respecting .dockerignore)
COPY . .

# Disable Next.js telemetry during the build to save time and bandwidth
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application (requires 'output: "standalone"' in next.config.ts)
RUN npm run build

# ==============================================================================
# STAGE 4: Production - Final minimal image for deployment
# ==============================================================================
FROM base AS runner

WORKDIR /app

# Set production environment variables
ENV NODE_ENV=production
# Disable Next.js telemetry during runtime
ENV NEXT_TELEMETRY_DISABLED=1
# Set the port for Next.js to run on
ENV PORT=3000
# Ensure Node listens on all network interfaces inside the container
ENV HOSTNAME="0.0.0.0"

# Create a non-root system user and group for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy the public directory (static assets)
COPY --from=builder /app/public ./public

# Set the correct permissions for the nextjs user on the .next directory
RUN mkdir .next
RUN chown nextjs:nodejs .next

# Automatically leverage output traces to reduce image size
# The standalone output includes only the files necessary to run the app
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Switch to the non-root user
USER nextjs

# Expose the application port
EXPOSE 3000

# Add a healthcheck to ensure the container is healthy
# This will ping the localhost on port 3000 every 30 seconds
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

# Start the server using the standalone Node.js file generated by Next.js
CMD ["node", "server.js"]
